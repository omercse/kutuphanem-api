# Bu dosyayi .env olarak kopyalayip kendi degerlerinizi girin.
# .env dosyasi ASLA git'e commit edilmemelidir.

# --- Veritabani ---
DB_URL=jdbc:postgresql://localhost:5432/kutuphane_db
DB_USER=postgres
DB_PASSWORD=degistir-beni

# --- JWT ---
# Uretmek icin: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- Ilk ADMIN kullanicisi (opsiyonel) ---
# Doluysa uygulama acilista sistemde hic ADMIN yoksa bir tane olusturur.
ADMIN_EMAIL=admin@kutuphanem.local
ADMIN_PASSWORD=

# --- Google Gemini ---
# https://aistudio.google.com/apikey adresinden alinir.
# Bos birakilirsa AI kategori tespiti devre disi kalir, kitaplar GENEL olur.
GEMINI_API_KEY=